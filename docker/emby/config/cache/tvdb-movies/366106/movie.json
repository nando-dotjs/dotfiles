:758,"height":140,"thumbnailWidth":0,"thumbnailHeight":0,"updatedAt":0},{"id":64467364,"image":"https://artworks.thetvdb.com/banners/v4/movie/366106/posters/68c1d66f7535b.jpg","thumbnail":"https://artworks.thetvdb.com/banners/v4/movie/366106/posters/68c1d66f7535b_t.jpg","language":"pt","type":14,"score":0,"width":680,"height":1000,"thumbnailWidth":0,"thumbnailHeight":0,"updatedAt":0},{"id":64482729,"image":"https://artworks.thetvdb.com/banners/v4/movie/366106/posters/68d34168d16c6.jpg","thumbnail":"https://artworks.thetvdb.com/banners/v4/movie/366106/posters/68d34168d16c6_t.jpg","language":"pol","type":14,"score":0,"width":680,"height":1000,"thumbnailWidth":0,"thumbnailHeight":0,"updatedAt":0},{"id":64448980,"image":"https://artworks.thetvdb.com/banners/v4/movie/366106/posters/68ae5a11bd6a8.jpg","thumbnail":"https://artworks.thetvdb.com/banners/v4/movie/366106/posters/68ae5a11bd6a8_t.jpg","language":"pol","type":14,"score":0,"width":680,"height":1000,"thumbnailWidth":0,"thumbnailHeight":0,"updatedAt":0},{"id":64531993,"image":"https://artworks.thetvdb.com/banners/v4/movie/366106/banners/690d3ecc21cfe.jpg","thumbnail":"https://artworks.thetvdb.com/banners/v4/movie/366106/banners/690d3ecc21cfe_t.jpg","language":"pt","type":16,"score":0,"width":758,"height":140,"thumbnailWidth":0,"thumbnailHeight":0,"updatedAt":0}],"remoteIds":[{"id":"tt35521922","type":2,"sourceName":"IMDB"},{"id":"1422096","type":10,"sourceName":"TheMovieDB.com"}],"characters":[{"id":69338870,"peopleId":316958,"movieId":"366106","type":3,"image":"","sort":1,"isFeatured":true,"url":"316958-larry-fessenden","peopleType":"Actor","personName":"Larry Fessenden","personImgURL":""},{"id":69338871,"peopleId":9092832,"movieId":"366106","type":3,"image":"","sort":2,"isFeatured":true,"url":"9092832-arielle-friedman","peopleType":"Actor","personName":"Arielle Friedman","personImgURL":""},{"id":69338874,"peopleId":9140251,"movieId":"366106","type":3,"image":"","sort":3,"isFeatured":true,"url":"9140251-indy","peopleType":"Actor","personName":"Indy","personImgURL":"https://artworks.thetvdb.com/banners/v4/actor/9140251/photo/680011ca19a58.jpg"},{"id":69338875,"peopleId":9140252,"movieId":"366106","type":3,"image":"","sort":4,"isFeatured":false,"url":"9140252-shane-jensen","peopleType":"Actor","personName":"Shane Jensen","personImgURL":""}],"budget":"0.00","boxOffice":"0.00","originalCountry":"usa","originalLanguage":"eng","tagOptions":"[{id:648,tag:10,tagName:Relationship Types,name:Person/Dog,helpText:For movies where there is a human-canine relationship at the center, like “Turner & Hooch.\"}]","lists":[{"id":17136,"name":"yuvgvbug","overview":"","url":"17136","isOfficial":false,"nameTranslations":["eng"],"overviewTranslations":"[eng]","aliases":[],"score":0,"image":"","imageIsFallback":false}],"translations":{"nameTranslations":[{"name":"Good Boy","language":"eng","IsPrimary":true},{"name":"Good Boy","tagline":"Zaufaj jego instynktowi","language":"pol","IsPrimary":false},{"name":"Bom Menino","language":"pt","IsPrimary":false},{"name":"Good Boy","language":"fra","IsPrimary":false},{"name":"Flink Bisk","language":"nor","IsPrimary":false},{"name":"Good Boy","language":"ita","IsPrimary":false},{"name":"Глазами пса","language":"rus","IsPrimary":false}],"overviewTranslations":[{"overview":"Do you ever wonder why your dog stares at empty corners, barks for no reason, or refuses to go into the basement? Good Boy is the story of a dog who sees everything that goes bump in the night. No talking pets, just terrifying scares.","language":"eng","IsPrimary":true},{"overview":"Pierwszy horror opowiedziany z perspektywy psa. Todd wprowadza się do starego domu rodzinnego, nie zważając na pogłoski o duchach. Tylko jego wierny pies Indy widzi i czuje, co naprawdę czai się w ciemności…","tagline":"Zaufaj jego instynktowi","language":"pol","IsPrimary":false},{"overview":"Um cão fiel se muda com Todd, seu tutor, para uma casa de campo. Lá, ele descobre forças sobrenaturais escondidas nas sombras. Quando as entidades sombrias ameaçam seu dono, o corajoso cão deve lutar para protegê-lo.","language":"pt","IsPrimary":false},{"overview":"Un chien fidèle emménage dans une maison familiale rurale avec son propriétaire Todd, mais découvre que des forces surnaturelles se cachent dans l'ombre. Alors que des entités sombres menacent son compagnon humain, le courageux chiot doit se battre pour protéger celui qu'il aime le plus.","language":"fra","IsPrimary":false},{"overview":"En lojal hund flytter til et landlig familiehjem med eieren sin, Todd, bare for å oppdage at overnaturlige krefter lurer i skyggene. Good Boy er historien om denne hunden, som ser alt som lager lyder i natten – og forklarer kanskje hvorfor hunder stirrer inn i tomme hjørner, bjeffer uten grunn, eller nekter å gå ned i kjelleren. Når mørke vesener truer menneskevennen hans, må den modige valpen kjempe for å beskytte den han elsker høyest. Ingen snakkende kjæledyr, bare ren skrekk.","language":"nor","IsPrimary":false},{"overview":"Ti sei mai chiesto perché il tuo cane fissa gli angoli vuoti, abbaia senza motivo o si rifiuta di scendere in cantina? Good Boy è la storia di un cane che vede tutto ciò che si muove nell’oscurità. Niente animali parlanti, solo spaventi da brivido.","language":"ita","IsPrimary":false},{"overview":"Владелец пса Инди страдает от серьёзной болезни. Вместе с собакой он переезжает в старый лесной дом, некогда принадлежавший его деду, и Инди сразу чует неладное. Отважный пёс пытается защитить хозяина от крадущихся из темноты зловещих теней.","language":"rus","IsPrimary":false}],"aliases":"[Good Boy]"},"companies":{"studio":[],"network":[],"production":[],"distributor":[],"special_effects":[]},"production_countries":[{"id":286344,"country":"usa","name":"United States of America"}],"inspirations":[],"spoken_languages":"[eng]","first_release":{"country":"usa","date":"2025-10-03","detail":"SXSW Film Festival"}}