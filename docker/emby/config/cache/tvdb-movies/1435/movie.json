-jackson-robert-scott","peopleType":"Actor","personName":"Jackson Robert Scott","personImgURL":"https://artworks.thetvdb.com/banners/v4/actor/8158005/photo/64d2614ef08d5.jpg"},{"id":65544625,"name":"Henry Bowers","peopleId":8152918,"movieId":"1435","type":3,"image":"https://artworks.thetvdb.com/banners/person/8152918/5fda4e0548d7c.jpg","sort":9,"isFeatured":true,"url":"8152918-nicholas-hamilton","peopleType":"Actor","personName":"Nicholas Hamilton","personImgURL":"https://artworks.thetvdb.com/banners/v4/actor/8152918/photo/66ef64e40345e.jpg"},{"id":65679665,"name":"Ben Hanscom","peopleId":8020129,"movieId":"1435","type":3,"image":"https://artworks.thetvdb.com/banners/person/8020129/5fda4d0930f90.jpg","sort":2,"isFeatured":true,"url":"8020129-jeremy-ray-taylor","peopleType":"Actor","personName":"Jeremy Ray Taylor","personImgURL":"https://artworks.thetvdb.com/banners/v4/actor/8020129/photo/630fad01187e8.jpg"},{"id":65679680,"name":"Betty Ripsom","peopleId":8181267,"movieId":"1435","type":3,"image":"https://artworks.thetvdb.com/banners/person/8181267/5fda4ec165faa.jpg","sort":27,"isFeatured":false,"url":"8181267-katie-lunman","peopleType":"Actor","personName":"Katie Lunman","personImgURL":""}],"budget":"35000000.00","boxOffice":"700400000.00","originalCountry":"usa","originalLanguage":"eng","studios":[{"id":29,"name":"Warner Bros. Pictures"}],"tagOptions":"[{id:175,tag:10,tagName:Relationship Types,name:Friends,helpText:null},{id:214,tag:12,tagName:Setting,name:Small Town,helpText:null},{id:234,tag:14,tagName:Supernatural Beings,name:Monsters,helpText:null},{id:4520,tag:3805,tagName:Credit Scenes,name:No,helpText:null},{id:200,tag:32,tagName:Geographic Location,name:America / United States,helpText:null},{id:411,tag:22,tagName:Sensitive Content & Trigger Warnings,name:Abuse,helpText:Including physical, mental, emotional, verbal, sexual abuse.},{id:415,tag:22,tagName:Sensitive Content & Trigger Warnings,name:Blood / Injury,helpText:null},{id:417,tag:22,tagName:Sensitive Content & Trigger Warnings,name:Bullying,helpText:null},{id:420,tag:22,tagName:Sensitive Content & Trigger Warnings,name:Death or Dying,helpText:null},{id:445,tag:22,tagName:Sensitive Content & Trigger Warnings,name:Slurs,helpText:null},{id:122,tag:5,tagName:Time Period,name:1980s,helpText:null}]","lists":[{"id":50,"name":"It Franchise","overview":"You'll float, too. Seven friends living in Derry, Maine, are terrorized by an eponymous being — who returns every 27 years — only to face their own personal demons in the process.","url":"it","isOfficial":true,"nameTranslations":["deu","eng","spa","tur"],"overviewTranslations":"[deu,eng,spa,tur]","aliases":[],"score":3835560,"image":"","imageIsFallback":false},{"id":16121,"name":"It Adaptations","overview":"All adaptations of Stephen King's It and spin-offs.","url":"16121","isOfficial":false,"nameTranslations":["eng"],"overviewTranslations":"[eng]","aliases":[],"score":3921595,"image":"","imageIsFallback":false}],"translations":{"nameTranslations":[{"name":"IT／イット “それ”が見えたら、終わり。","language":"jpn","IsPrimary":false},{"name":"Az","language":"hun","IsPrimary":false},{"name":"It: Chapter One","language":"nld","IsPrimary":false},{"name":"Es","language":"deu","IsPrimary":false},{"name":"Det","language":"swe","IsPrimary":false},{"name":"O: Bölüm 1","tagline":"En büyük korkun ne?","language":"tur","IsPrimary":false},{"name":"Оно","language":"rus","IsPrimary":false},{"name":"小丑回魂","language":"zho","IsPrimary":false},{"name":"It","tagline":"Também irás flutuar.","language":"por","IsPrimary":false},{"name":"זה","language":"heb","IsPrimary":false},{"name":"Se","language":"fin","IsPrimary":false},{"name":"Ça","language":"fra","IsPrimary":false},{"name":"To","language":"ces","IsPrimary":false},{"name":"To","tagline":"Ciebie też porwie","language":"pol","IsPrimary":false},{"name":"그것","language":"kor","IsPrimary":false},{"name":"Ono","language":"hrv","IsPrimary":false},{"name":"It","language":"eng","IsPrimary":true},{"name":"It: A Coisa","language":"pt","IsPrimary":false},{"name":"It - Capitolo uno","language":"ita","IsPrimary":false},{"name":"It","tagline":"Tú también flotarás.","language":"spa","IsPrimary":false},{"name":"الشيء","language":"ara","IsPrimary":false}],"overviewTranslations":[{"overview":"Ein Clown bringt Kinder eigentlich zum Lachen. Doch nicht in Derry, Maine, wo eine Gruppe von Außenseitern ihren schlimmsten Albtraum erlebt. Alle 27 Jahre kommt das personifizierte Böse aus der Kanalisation und terrorisiert die Kinder der Stadt. Gemeinsam müssen sie ihre persönlichen Ängste überwinden, denn nur so lässt sich auch der mörderische, blutrünstige Clown Pennywise besiegen.","language":"deu","IsPrimary":false},{"overview":"Stephen King'in romanından uyarlanan filmde, 1989 yazında Derry, Maine’de yaşayan bir grup çocuğun 27 yılda bir kasabanın çocuklarını avlayan şeytanı bir varlığı durdurmak için verdikleri mücadele anlatılmaktadır.","tagline":"En büyük korkun ne?","language":"tur","IsPrimary":false},{"overview":"Когда в городке Дерри штата Мэн начинают пропадать дети, несколько ребят сталкиваются со своими величайшими страхами — не только с группой школьных хулиганов, но со злобным клоуном Пеннивайзом, список жертв которого уходит вглубь веков.","language":"rus","IsPrimary":false},{"overview":"Após o desaparecimento misterioso de algumas crianças na cidade de Derry, no Maine, um grupo de pré-adolescentes é confrontado com os seus maiores medos quando inicia um confronto com o maquiavélico palhaço Pennywise, cujo historial de crimes e violência tem origem há séculos.","tagline":"Também irás flutuar.","language":"por","IsPrimary":false},{"overview":"À Derry, dans le Maine, sept gamins ayant du mal à s'intégrer se sont regroupés au sein du \"Club des Ratés\". Rejetés par leurs camarades, ils sont les cibles favorites des gros durs de l'école. Ils ont aussi en commun d'avoir éprouvé leur plus grande terreur face à un terrible prédateur métamorphe qu'ils appellent \"Ça\"… \r\nCar depuis toujours, Derry est en proie à une créature qui émerge des égouts tous les 27 ans pour se nourrir des terreurs de ses victimes de choix : les enfants. Bien décidés à rester soudés, les Ratés tentent de surmonter leurs peurs pour enrayer un nouveau cycle meurtrier. Un cycle qui a commencé un jour de pluie lorsqu'un petit garçon poursuivant son bateau en papier s'est retrouvé face-à-face avec le Clown Grippe-Sou …","language":"fra","IsPrimary":false},{"overview":"Dzieci z małego miasteczka terroryzuje tajemnicza istota przybierająca postać klauna.","tagline":"Ciebie też porwie","language":"pol","IsPrimary":false},{"overview":"Seven young outcasts in Derry, Maine, face their worst nightmare - an ancient, shape-shifting evil that emerges from the sewer every 27 years to prey on the town's children. Banding together over the course of one horrifying summer, the friends must overcome their own personal fears to battle the murderous, bloodthirsty clown known as Pennywise.","language":"eng","IsPrimary":true},{"overview":"Um grupo de sete adolescentes de Derry, uma cidade no Maine, formam o auto-intitulado clube dos perdedores. A pacata rotina da cidade é abalada quando crianças começam a desaparecer e tudo o que pode ser encontrado delas são partes de seus corpos. Logo, os integrantes do clube acabam ficando face a face com o responsável pelos crimes: o palhaço Pennywise.","language":"pt","IsPrimary":false},{"overview":"Quando in città i bambini iniziano a sparire, alcuni ragazzi emarginati affrontano le loro più grandi paure e un terrificante clown omicida apparentemente invincibile.","language":"ita","IsPrimary":false},{"overview":"En el verano de 1989, un grupo de niños acosados se unen para destruir un monstruo que cambia de forma, que se disfraza de payaso y se alimenta de los niños de Derry, su pequeña ciudad de Maine.","tagline":"Tú también flotarás.","language":"spa","IsPrimary":false},{"overview":"سبعة شبان منبوذين في ديري بولاية ماين على وشك مواجهة أسوأ كابوس لهم - شر قديم متغير الشكل يخرج من المجاري كل 27 عامًا ليفترس أطفال المدينة.","language":"ara","IsPrimary":false}],"aliases":"[Es - Kapitel 1,IT: The Losers' Club,It: Chapter One]"},"contentRatings":[{"id":253,"name":"SAM16","country":"arg","description":"Suitable for ages 16 and over","contentType":"movie","order":0,"fullname":"SAM16"},{"id":259,"name":"MA15+","country":"aus","description":"Not suitable for viewers under 15","contentType":"movie","order":0,"fullname":"MA15+"},{"id":269,"name":"16+","country":"aut","description":"Suitable for ages 16 and up","contentType":"movie","order":0,"fullname":"16+"},{"id":281,"name":"16","country":"bra","description":"Not recommended for minors under 16","contentType":"movie","order":0,"fullname":"16"},{"id":290,"name":"14A","country":"can","description":"Parental guidance advised for viewers 14 or younger","contentType":"movie","order":0,"fullname":"14+"},{"id":297,"name":"14","country":"chl","description":"Recommended for viewers over 14 years old","contentType":"movie","order":0,"fullname":"14"},{"id":302,"name":"15","country":"col","description":"Restricted to viewers over 15","contentType":"movie","order":0,"fullname":"15"},{"id":309,"name":"15","country":"dnk","description":"Recommended for ages 15 and up","contentType":"movie","order":0,"fullname":"15"},{"id":70,"name":"16","country":"fin","description":"16 and older","contentType":"episode","order":0,"fullname":"16"},{"id":324,"name":"-12","country":"fra","description":"Prohibiting for minors under 12","contentType":"movie","order":0,"fullname":"-12"},{"id":331,"name":"16+","country":"deu","description":"Restricted to ages 16 and older","contentType":"movie","order":0,"fullname":"16+"},{"id":540,"name":"15","country":"gbr","description":"Restricted to ages 15 and older","contentType":"movie","order":0,"fullname":"15"},{"id":82,"name":"16","country":"grc","description":"Suitable for ages 16 and up","contentType":"episode","order":0,"fullname":"16"},{"id":340,"name":"IIB","co